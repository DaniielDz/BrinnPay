# BrinnPay API environment defaults (non-secret).
# Copy to `.env` for local development: `cp .env.example .env`.
# Never commit real secrets.

NODE_ENV=development
PORT=3000
SERVICE_NAME=brinnpay-api

# PostgreSQL (matches docker/compose.yml local defaults)
DATABASE_URL=postgresql://brinnpay:brinnpay@localhost:5432/brinnpay?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:3001

# Logging
LOG_LEVEL=info

# Canonical OpenAPI contract and Swagger UI mount path
OPENAPI_PATH=../../docs/openapi.yaml
SWAGGER_PATH=docs
