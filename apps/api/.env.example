# BrinnPay API environment defaults (non-secret).
# Copy to `.env` for local development: `cp .env.example .env`.
# Never commit real secrets.

NODE_ENV=development
PORT=3000
SERVICE_NAME=brinnpay-api

# PostgreSQL (matches docker/compose.yml local defaults)
DATABASE_URL=postgresql://brinnpay:brinnpay@localhost:5432/brinnpay?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:3001

# Logging
LOG_LEVEL=info

# Canonical OpenAPI contract and Swagger UI mount path
OPENAPI_PATH=../../docs/openapi.yaml
SWAGGER_PATH=docs

# --- Authentication (Phase 3) ---

# REQUIRED (outside test): JWT access-token signing secret, at least 32 chars.
# Generate one with: `openssl rand -base64 48`
# JWT_SECRET=

# Access-token lifetime in seconds (default 900 / 15 min)
# ACCESS_TOKEN_TTL_SECONDS=900

# Auth cookie attributes
# COOKIE_SAME_SITE=lax          # or strict
# COOKIE_SECURE=false          # true in secure/production environments
# AUTH_COOKIE_NAME=brinnpay_refresh

# Refresh-session lifetime in days (default 30; rotation extends the window)
# REFRESH_SESSION_TTL_DAYS=30

# Rate limiting on /auth/* endpoints (window in seconds). These names, defaults
# and meaning are unchanged from phase 3 (D9); they still govern the `auth.*`
# rate-limit classes.
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# AUTH_RATE_LIMIT_IP_LOGIN_MAX=10
# AUTH_RATE_LIMIT_ACCOUNT_LOGIN_MAX=10
# AUTH_RATE_LIMIT_IP_REFRESH_MAX=60
# AUTH_RATE_LIMIT_IP_READ_MAX=100

# --- Payments simulation (Phase 7) ---

# State-machine advancement delays in milliseconds (phase 7 §4.6, D2):
# pending → processing after PENDING, processing → succeeded after a further
# SETTLEMENT (both counted from created_at; defaults 1000/2000).
# PAYMENT_PENDING_DELAY_MS=1000
# PAYMENT_SETTLEMENT_DELAY_MS=2000

# --- Idempotency (Phase 8) ---

# Retention window of a stored idempotency response, in hours (ADR-0004; the
# single constant shared by storage and the API documentation). Reusing a key
# after this window is a new operation.
# IDEMPOTENCY_RETENTION_HOURS=24

# --- Webhooks (Phase 10) ---

# REQUIRED: base64 AES-256-GCM key protecting endpoint signing secrets at rest
# (D8). Validated at boot like JWT_SECRET. There is no inference-based fallback —
# set this in any process that stores rows, including one running NODE_ENV=test.
# Generate one with: `openssl rand -base64 32`
# WEBHOOK_ENCRYPTION_KEY=

# Development only. Substitutes the committed test key so a unit suite can boot
# with no secrets injected. Ignored once DATABASE_URL is set, because the
# connection string falls back to a hardcoded localhost default and "no
# DATABASE_URL exported" does not mean "no database".
# WEBHOOK_ALLOW_INSECURE_TEST_KEY=

# Delivery attempts per delivery, first attempt included (D5; default 5,
# maximum 20 — a value above it fails at boot rather than being clamped)
# WEBHOOK_MAX_ATTEMPTS=5

# Exponential full-jitter backoff in milliseconds (D5; defaults 30000/3600000)
# WEBHOOK_BASE_BACKOFF_MS=30000
# WEBHOOK_MAX_BACKOFF_MS=3600000

# Outbound request timeouts in milliseconds (§5.4; defaults 5000/10000)
# WEBHOOK_CONNECT_TIMEOUT_MS=5000
# WEBHOOK_REQUEST_TIMEOUT_MS=10000

# Retention of stored events in days (D9; default 30). Expired events are 404 on
# replay and absent from listings; their deliveries cascade with the event.
# WEBHOOK_EVENT_RETENTION_DAYS=30

# Maintenance sweep intervals in milliseconds, all worker-side (D2/D3/D9)
# WEBHOOK_RECONCILIATION_INTERVAL_MS=60000
# WEBHOOK_ADVANCEMENT_SWEEP_INTERVAL_MS=5000
# WEBHOOK_CLEANUP_INTERVAL_MS=3600000

# How far back one reconciliation pass may repair, in milliseconds (D2; default
# 3600000 = 1 hour). The pass only scans events younger than this, so creating or
# re-enabling an endpoint backfills the events it missed within this window, not
# the whole retention window. Must be greater than the pass's minimum age.
# WEBHOOK_RECONCILIATION_HORIZON_MS=3600000

# Retention of finished queue jobs (default: completed jobs are removed at once;
# failed jobs are kept for 7 days, at most 1000 at a time). Bounds Redis growth.
# WEBHOOK_FAILED_JOB_RETENTION_MS=604800000
# WEBHOOK_RETAINED_FAILED_JOBS=1000

# Optional destination policy (D13): comma-separated exact hosts. Private,
# loopback, and link-local destinations are permitted by default, so both lists
# are empty unless a deployment restricts outbound delivery. The allowlist wins.
# WEBHOOK_DESTINATION_ALLOWLIST=
# WEBHOOK_DESTINATION_DENYLIST=

# --- Request logging (Phase 11) ---

# Retention of persisted request-log rows, in days (D5; default 30, aligned
# with webhook event retention). Rows past the window are dropped by the
# periodic cleanup pass; expired records are simply gone.
# REQUEST_LOG_RETENTION_DAYS=30

# How often the request-log retention pass runs, in milliseconds (D5;
# default 3600000 = 1 hour, registered with the Phase 10 worker's periodic
# maintenance — it never runs on the request path).
# REQUEST_LOG_CLEANUP_INTERVAL_MS=3600000

# --- Rate limiting (Phase 13) ---
#
# Every request under /api/v1 consumes a per-client-IP budget; API-key
# authenticated requests additionally consume a per-key budget so one tenant
# cannot exhaust another's capacity. Limits are generous by design — a sandbox
# whose own developer cannot run a payment/retry/replay loop is not usable.
# Every value is validated at boot: a non-integer or non-positive one fails
# rather than silently disabling throttling.
#
# Generic classes (`read` = every other GET, `write` = every other
# POST/PATCH/DELETE except the two webhook classes below).
# RATE_LIMIT_READ_MAX=600
# RATE_LIMIT_WRITE_MAX=120
# RATE_LIMIT_WINDOW_SECONDS=60

# Webhook replay is a deliberate outbound amplifier; each webhook endpoint adds
# an in-transaction fan-out row, so both are capped separately.
# RATE_LIMIT_WEBHOOK_REPLAY_MAX=20
# RATE_LIMIT_WEBHOOK_REPLAY_WINDOW_SECONDS=300
# RATE_LIMIT_WEBHOOK_ENDPOINT_CREATE_MAX=10
# RATE_LIMIT_WEBHOOK_ENDPOINT_CREATE_WINDOW_SECONDS=3600

# Redis-unavailability posture (D8). `open` (default) degrades enforcement to a
# bounded in-process store — a sandbox should not trade availability for
# enforcement — with one warning and no 5xx; `closed` rejects with 429 instead.
# Either way /health/ready is unaffected and a Redis error never becomes a 5xx.
# RATE_LIMIT_FAIL_MODE=open

# Client identity and proxy trust (D1). The default (0 / empty) uses the direct
# socket peer and ignores forwarded headers for limit purposes, so a caller
# cannot forge its budget with `X-Forwarded-For`. A deployment behind a load
# balancer sets an explicit bounded trust: a CIDR allowlist of the proxy
# addresses (mandatory). The shortest accepted prefix is /8 for IPv4 and /32
# for IPv6 — an IPv6 block is 4 billion times larger per prefix bit: 2000::/8
# is every globally routable peer and ::/8 contains the whole IPv4-mapped
# range — and an IPv4-mapped entry (`::ffff:0:0/96`) is held to the IPv4 floor
# too, because it is an IPv4 range in disguise. Plus a hop count (at most 10)
# bounding how much of the chain is read. Boot refuses a hop count with no
# allowlist, because a hop count bounds how much of the chain is read, never
# who wrote it. The proxy must *append* to X-Forwarded-For: a proxy that
# forwards the caller's header unchanged cannot be distinguished from the
# caller, so nothing here can recover a client identity behind it.
# TRUST_PROXY_HOPS=0
# TRUST_PROXY_CIDRS=
