{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "sourceMap": false,
    "types": []
  },
  "include": ["**/*.js"]
}