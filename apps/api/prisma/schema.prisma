// BrinnPay — Prisma schema.
//
// ADR-0011: Phase 2 added the datasource + generator only; domain models are
// introduced by their owning phases via committed migrations. Conventions fixed
// for all phases (recorded here and applied across models):
//   - entity IDs are PostgreSQL `uuid` columns storing UUIDv7 (ADR-0001);
//   - `snake_case` table and column names;
//   - every record carries `created_at`; mutable records carry `updated_at`;
//   - timestamps are UTC;
//   - application code supplies ID and timestamp values (no DB-side defaults).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Phase 3 + (ADR-0011): authentication domain. Phase 4 (Organizations & RBAC)
// owns extending `organizations` / `organization_members` and introduces
// `invitations`: organization (tenant) boundary, memberships with roles, and
// email-bound invitations (pending → accepted | canceled). Roles and statuses
// are app-validated enums stored in `varchar` columns (D10); the partial unique
// index on pending (organization_id, email) lives in the migration as raw SQL.

model User {
  id           String    @id @db.Uuid
  email        String    @unique @db.VarChar(320)
  name         String?   @db.VarChar(120)
  passwordHash String    @map("password_hash") @db.VarChar(191)
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(3)

  refreshSessions RefreshSession[]
  memberships     OrganizationMember[]
  requestLogs     RequestLog[]

  @@map("users")
}

model RefreshSession {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model Organization {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  members     OrganizationMember[]
  invitations Invitation[]
  projects    Project[]
  requestLogs RequestLog[]

  @@map("organizations")
}

// Phase 5 (ADR-0011): projects + api_keys. `projects` is the tenant-owned
// container for customers, payments, API keys, and webhooks; both simulated
// environments (`test`/`live`) are always available and are derived by the
// service (D6) — never stored. `api_keys` stores only the SHA-256 hash of the
// credential (ADR-0006, D4) with a global unique constraint; the plaintext is
// shown exactly once at creation. `revoked_at` is the only mutation apart from
// creation (the contract's `ApiKey` has no `updated_at`). Both tables cascade
// from their tenant: organization deletion removes projects and their keys
// (D7); project deletion removes its keys.

// Phase 6 (ADR-0011): customers. `customers` is the developer-managed customer
// record (ADR-0008): an API-level entity scoped to exactly one project and one
// environment (`test`/`live` — app-validated, D10 pattern) with duplicate
// emails permitted (D1: identity is the UUIDv7 id) and a flat string-map
// `metadata` (D6; `{}` when absent). FK to `projects` with ON DELETE CASCADE
// (project deletion removes its customers); the composite (project, environment)
// index serves the environment-scoped list scans.

// Phase 8 (ADR-0011): idempotency records. `idempotency_records` is **internal
// infrastructure** for the cross-cutting idempotency capability (phase 8 §4):
// it stores the API response projection of a committed mutation so a retry of
// the same key replays it instead of re-executing the side effect. The table is
// deliberately operation-agnostic — the unique tuple
// (project_id, operation_scope, idempotency_key) is what scopes a key
// (ADR-0004), so `refunds.create` (Phase 9) needs no schema change. FK to
// `projects` ON DELETE CASCADE (idempotency is project-scoped; project deletion
// removes its records). `response_status`/`response_body` are nullable because
// the claim row is inserted before the mutation runs and completed by an update
// **inside the same transaction** (phase 8 §4.4 — atomic failure handling).

// Phase 7 (ADR-0011): payments. `payments` is the simulated payment operation
// (ADR-0008-derived, no real money): scoped to exactly one project and one
// environment (`test`/`live`, app-validated) and to one customer of the same
// (project, environment). `amount_minor` stores integer minor units (ADR-0002,
// USD scale 2) as `bigint` so amounts cannot overflow; `currency` is `usd` only
// in the MVP (ADR-0003); `status`/`failure_code` are app-validated (phase 4 D10
// pattern; `failure_code` is null unless `status = failed`, catalog is
// Phase 16). FKs: `project_id` ON DELETE CASCADE (project deletion removes its
// payments) and `customer_id` ON DELETE RESTRICT (D4 — a customer with payments
// cannot be deleted). Indexes serve the environment-scoped list scans
// (id-ordered cursor pagination) and the delete-with-payments check.
// Transition times are derived from `created_at` and the delay constants
// (phase 7 §4.6) — no separate transition columns.

model Project {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(200)
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys            ApiKey[]
  customers          Customer[]
  payments           Payment[]
  idempotencyRecords IdempotencyRecord[]
  webhookEndpoints   WebhookEndpoint[]
  webhookEvents      WebhookEvent[]
  requestLogs        RequestLog[]

  @@index([organizationId])
  @@map("projects")
}

model Customer {
  id          String   @id @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  environment String   @db.VarChar(20)
  email       String   @db.VarChar(320)
  name        String?  @db.VarChar(200)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([projectId])
  @@index([projectId, environment])
  @@map("customers")
}

model Payment {
  id          String   @id @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  environment String   @db.VarChar(20)
  customerId  String   @map("customer_id") @db.Uuid
  amountMinor BigInt   @map("amount_minor") @db.BigInt
  currency    String   @db.VarChar(3)
  status      String   @db.VarChar(20)
  failureCode String?  @map("failure_code") @db.VarChar(50)
  description String?  @db.VarChar(500)
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  refunds  Refund[]

  @@index([projectId, environment])
  @@index([customerId])
  @@map("payments")
}

// Phase 9: every refund is a synchronous, succeeded operation against one
// payment. The parent determines project, environment and currency; serialize
// balance checks on the payment row in the creation transaction.
model Refund {
  id          String   @id @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  amountMinor BigInt   @map("amount_minor") @db.BigInt
  currency    String   @db.VarChar(3)
  status      String   @db.VarChar(20)
  reason      String?  @db.VarChar(255)
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, id])
  @@map("refunds")
}

// Idempotency records (phase 8 §5). Internal infrastructure — no public API
// resource (phase 1 §13.2.2). `operation_scope` holds catalog values such as
// `payments.create` and `refunds.create` (string-based, app-owned); the stored
// body is the API response projection (not a row dump), so replay stays
// contract-correct. The compound unique index is what enforces one active
// record per (project, operation scope, key) and backs the atomic claim
// (phase 8 §4.4); `expires_at` (`created_at` + 24h, ADR-0004) drives expiry and
// the request-path reuse rule plus the bounded-storage cleanup.
// Phase 10 (ADR-0011): webhooks. Three tables with distinct ownership:
//
//   1. `webhook_events` — the immutable, project-scoped event store. One row per
//      (project, environment) domain event, with a UUIDv7 `id` supplied by the
//      emitting module (re-persistence is a no-op, phase 10 §4.3.5) and
//      `payload` holding the canonical phase 1 §9.5 envelope — the same bytes
//      that are delivered, so a replay is byte-identical. `type` and
//      `environment` are app-validated. FK to `projects` ON DELETE CASCADE.
//   2. `webhook_endpoints` — the developer-registered destination. The signing
//      secret must be recoverable to sign (it cannot be hashed like an API
//      key), so it is stored encrypted with AES-256-GCM: ciphertext, IV and
//      auth tag in separate columns (D8). The plaintext is returned exactly
//      once, at creation, and never again. Duplicate URLs are allowed (D16).
//   3. `webhook_deliveries` — the per-(event, endpoint) delivery aggregate
//      (D4): an `attempts` counter plus the last attempt's outcome, not one
//      row per attempt. `last_error` is a bounded, sanitized summary — never a
//      response body, never a secret. `request_id` records the API request
//      that caused the event (phase 1 §7.7). FKs cascade from the endpoint and
//      the event, so deleting an endpoint removes its delivery records while
//      the project-scoped events survive (D11).
//
// Indexes serve the environment-scoped cursor scans
// `(project_id, environment, id)`, the per-endpoint delivery scan
// `(endpoint_id, id)`, the enabled-endpoint subscription match, and the
// retention cleanup scan.

model WebhookEndpoint {
  id            String   @id @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  environment   String   @db.VarChar(20)
  url           String   @db.VarChar(2048)
  eventTypes    String[] @map("event_types")
  enabled       Boolean  @default(true)
  secretCipher  String   @map("secret_ciphertext") @db.VarChar(512)
  secretIv      String   @map("secret_iv") @db.VarChar(64)
  secretAuthTag String   @map("secret_auth_tag") @db.VarChar(64)
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(3)

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId, environment, id])
  @@index([projectId, environment, enabled])
  @@map("webhook_endpoints")
}

model WebhookEvent {
  id          String   @id @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  environment String   @db.VarChar(20)
  type        String   @db.VarChar(50)
  payload     Json     @db.JsonB
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId, environment, id])
  @@index([projectId, environment, type])
  @@index([createdAt])
  @@map("webhook_events")
}

model WebhookDelivery {
  id             String    @id @db.Uuid
  endpointId     String    @map("endpoint_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  status         String    @db.VarChar(20)
  attempts       Int       @default(0)
  responseStatus Int?      @map("response_status")
  lastError      String?   @map("last_error") @db.VarChar(500)
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  requestId      String?   @map("request_id") @db.VarChar(64)
  isReplay       Boolean   @default(false) @map("is_replay")
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event    WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([endpointId, id])
  // "at most one delivery per (event, endpoint)" (§4.3.6) is enforced by the
  // partial unique index `webhook_deliveries_event_endpoint_unique` in the
  // migration (raw SQL — Prisma cannot express a `WHERE is_replay = false`
  // unique index declaratively, the Phase 4 invitation pattern). Replays are
  // deliberately excluded so a manual replay can create another delivery.
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model IdempotencyRecord {
  id             String   @id @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  operationScope String   @map("operation_scope") @db.VarChar(100)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body") @db.JsonB
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, operationScope, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model ApiKey {
  id          String    @id @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  environment String    @db.VarChar(20)
  keyHash     String    @unique @map("key_hash") @db.VarChar(64)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  requestLogs RequestLog[]

  @@index([projectId])
  @@map("api_keys")
}

// Phase 11 (ADR-0011): request logs. `request_logs` is the durable, API-wide
// projection of one request/response (phase 11 §5.1): metadata allowlist only —
// the table has no column capable of holding a body, a header, a query string or
// a secret, so absence is the control (§4.2 rule 4, D6). `request_id` is the
// server-assigned ingress correlation id (phase 1 §7.7); every other column is
// nullable scope except `method`/`path`/`status_code`/`created_at`, which every
// record carries.
//
// Tenant lifecycle: project and organization deletions cascade their rows so no
// orphaned tenant data remains queryable; `user_id`/`api_key_id` are
// `ON DELETE SET NULL` because a user or a soft-revoked key must never take the
// surrounding log history with it (keys are only hard-removed with their
// project). Records with an all-null tenant scope (public/auth traffic) live
// until retention expiry only.
//
// Indexes serve the project-scoped cursor scan and the D1 environment filter
// `(project_id, environment, id)`, the D8 exact `request_id` lookup, and the
// retention cutoff scan on `created_at`.
model RequestLog {
  id             String   @id @db.Uuid
  requestId      String   @map("request_id") @db.VarChar(64)
  projectId      String?  @map("project_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  apiKeyId       String?  @map("api_key_id") @db.Uuid
  environment    String?  @db.VarChar(20)
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(2048)
  statusCode     Int      @map("status_code")
  durationMs     Int?     @map("duration_ms")
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey       ApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([projectId, id])
  @@index([projectId, environment, id])
  @@index([requestId])
  @@index([createdAt])
  @@map("request_logs")
}

model OrganizationMember {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String       @db.VarChar(50)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String       @db.VarChar(320)
  role           String       @db.VarChar(50)
  status         String       @db.VarChar(20)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(3)
  acceptedAt     DateTime?    @map("accepted_at") @db.Timestamptz(3)
  canceledAt     DateTime?    @map("canceled_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The "one pending invitation per (organization, email)" rule is enforced by
  // the partial unique index in the migration (raw SQL — Prisma cannot express
  // `WHERE status = 'pending'` declaratively).
  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}
