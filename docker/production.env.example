# BrinnPay — production configuration contract (Phase 21, §6 M3, ADR-0044).
#
# One template for every environment key the three production processes
# consume (API / webhook worker / web). Copy it, fill in the values, and hand
# it to whatever runs the container (developer shell + uncommitted `.env` for
# the local validation run; CI secrets in Phase 23; AWS Secrets Manager in
# Phase 24 — the model, not the store, ships here).
#
# Classification legend:
#   REQUIRED  — boot refuses to start without it (fail-fast, never weakened)
#   OPTIONAL  — a documented default applies when unset
#   SECRET    — never commit a real value; inject at start time only
#   NON-SECRET— operational value, safe to review
#
# No real value for anything lives in this file. Secrets are empty on
# purpose: an image or a committed file must never carry one (§4 rule 2/3).
#
# Generation commands (§6 M4):
#   JWT_SECRET              openssl rand -base64 48
#   WEBHOOK_ENCRYPTION_KEY  openssl rand -base64 32
#   METRICS_SCRAPE_TOKEN    openssl rand -base64 48   (when metrics are enabled)
#
# Per-process matrix (§6 M3):
#   api     — everything below except WORKER_METRICS_PORT is honored; CORS_ORIGINS is required for it
#   worker  — DATABASE_URL, REDIS_URL, JWT_SECRET, WEBHOOK_ENCRYPTION_KEY and the
#             webhook/rate-limit/metrics knobs; WORKER_METRICS_PORT is its own
#   web     — NEXT_PUBLIC_API_BASE_URL, WEB_SECURE, PORT, HOSTNAME only
#
# Cross-process rule (F8/§8 rule 7): API and worker MUST receive identical
# JWT_SECRET and WEBHOOK_ENCRYPTION_KEY values. A mismatch is silent at boot
# and only shows up as failed webhook signatures.

# --- Process -----------------------------------------------------------------

# NON-SECRET, REQUIRED for production posture: the documented production
# setting. Production defaults that follow from it (F7): COOKIE_SECURE=true,
# WEB_SECURE=true (web), METRICS_ENABLED=false.
NODE_ENV=production

# NON-SECRET, OPTIONAL (api default 3000, web default 3001).
# PORT=3000
# SERVICE_NAME=brinnpay-api          # api/worker label in logs and readiness payloads

# --- Datastores ---------------------------------------------------------------

# REQUIRED, SECRET (api + worker). PostgreSQL connection string. In an
# environment that exists later this points at the managed database
# (Phase 24); locally it points at the validation stack's postgres service.
DATABASE_URL=

# REQUIRED, SECRET (api + worker). Redis connection string (BullMQ + rate limiting).
REDIS_URL=

# --- Web (production runtime) --------------------------------------------------

# NON-SECRET, REQUIRED (web) — the API origin the browser calls. BUILD-TIME
# input for the web image (inlined into the client bundle and the CSP
# `connect-src` origin): changing it for a deployed image requires a REBUILD
# of the web image, and the value must match the deployed API (F3/§6 M2).
# Set it both as a build argument and as runtime environment so the CSP
# matches the bundle.
NEXT_PUBLIC_API_BASE_URL=

# NON-SECRET, OPTIONAL (web) — BUILD-TIME input for the web image. Gates HSTS
# and the secure-transport posture (ADR-0028): the standalone server evaluates
# `next.config` headers during `next build`, so this is passed as a build
# argument. Unset keeps the secure production default (HSTS on, because
# NODE_ENV=production). The Phase 21 validation run builds with false —
# plain HTTP, run-scoped only (D8(a)); never write that relaxation back as a
# default. Changing it for a deployed image requires a web image rebuild.
# WEB_SECURE=true

# NON-SECRET, OPTIONAL (web). Port the standalone server listens on.
# PORT=3001
# HOSTNAME=0.0.0.0

# --- Authentication (Phase 3) ---------------------------------------------------

# REQUIRED, SECRET (api + worker). JWT access-token signing secret, at least
# 32 characters. Boot refuses a missing/weak value and never echoes it.
JWT_SECRET=

# NON-SECRET, OPTIONAL. Access-token lifetime in seconds (default 900).
# ACCESS_TOKEN_TTL_SECONDS=900

# NON-SECRET, OPTIONAL (api). Auth cookie attributes. COOKIE_SECURE defaults
# to true under NODE_ENV=production (F7) — an environment behind TLS keeps
# that default; the local plain-HTTP validation run sets false (D8(a),
# run-scoped). COOKIE_SAME_SITE: lax (default) | strict.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# AUTH_COOKIE_NAME=brinnpay_refresh
# REFRESH_SESSION_TTL_DAYS=30

# NON-SECRET, OPTIONAL (api). Rate limits on /auth/* (phase-3 names, D9).
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# AUTH_RATE_LIMIT_IP_LOGIN_MAX=10
# AUTH_RATE_LIMIT_ACCOUNT_LOGIN_MAX=10
# AUTH_RATE_LIMIT_IP_REFRESH_MAX=60
# AUTH_RATE_LIMIT_IP_READ_MAX=100

# --- CORS ----------------------------------------------------------------------

# REQUIRED (api), NON-SECRET. Comma-separated browser origins allowed to call
# the API with credentials. Boot refuses an empty list. In an environment that
# exists later this is the deployed web origin (plus the dashboard origin).
CORS_ORIGINS=

# --- Logging -------------------------------------------------------------------

# NON-SECRET, OPTIONAL (api + worker). Default: info
# LOG_LEVEL=info

# --- OpenAPI / Swagger ---------------------------------------------------------

# NON-SECRET, OPTIONAL. The production image ships the contract at
# /app/docs/openapi.yaml, which matches the defaults below — override only if
# the layout changes. Swagger UI keeps serving at /docs in production (D7/Q4).
# OPENAPI_PATH=../../docs/openapi.yaml
# SWAGGER_PATH=docs

# --- Payments simulation (Phase 7) ----------------------------------------------

# NON-SECRET, OPTIONAL (api + worker). State-machine delays in ms (defaults 1000/2000).
# PAYMENT_PENDING_DELAY_MS=1000
# PAYMENT_SETTLEMENT_DELAY_MS=2000

# --- Idempotency (Phase 8) -------------------------------------------------------

# NON-SECRET, OPTIONAL (api). Retention window in hours (default 24, ADR-0004).
# IDEMPOTENCY_RETENTION_HOURS=24

# --- Webhooks (Phase 10) ---------------------------------------------------------

# REQUIRED, SECRET (api + worker — identical values, F8). Base64 AES-256-GCM
# key protecting endpoint signing secrets at rest. Exactly 32 bytes; boot
# refuses a missing/weak value and never echoes it.
WEBHOOK_ENCRYPTION_KEY=

# NEVER SET IN PRODUCTION. Development-only opt-in for the committed test key;
# ignored once DATABASE_URL is set, and meaningless here.
# WEBHOOK_ALLOW_INSECURE_TEST_KEY=

# NON-SECRET, OPTIONAL (api + worker). Delivery policy and sweep cadence —
# defaults as documented in apps/api/.env.example.
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_BASE_BACKOFF_MS=30000
# WEBHOOK_MAX_BACKOFF_MS=3600000
# WEBHOOK_CONNECT_TIMEOUT_MS=5000
# WEBHOOK_REQUEST_TIMEOUT_MS=10000
# WEBHOOK_EVENT_RETENTION_DAYS=30
# WEBHOOK_RECONCILIATION_INTERVAL_MS=60000
# WEBHOOK_RECONCILIATION_HORIZON_MS=3600000
# WEBHOOK_ADVANCEMENT_SWEEP_INTERVAL_MS=5000
# WEBHOOK_CLEANUP_INTERVAL_MS=3600000
# WEBHOOK_FAILED_JOB_RETENTION_MS=604800000
# WEBHOOK_RETAINED_FAILED_JOBS=1000

# NON-SECRET, OPTIONAL (api + worker). Outbound destination policy (D13).
# Both empty = permissive sandbox posture; a deployment that must restrict
# outbound delivery sets exact hosts (allowlist wins).
# WEBHOOK_DESTINATION_ALLOWLIST=
# WEBHOOK_DESTINATION_DENYLIST=

# --- Request logging (Phase 11) ---------------------------------------------------

# NON-SECRET, OPTIONAL (api + worker). Retention in days / cleanup interval in ms.
# REQUEST_LOG_RETENTION_DAYS=30
# REQUEST_LOG_CLEANUP_INTERVAL_MS=3600000

# --- Rate limiting (Phase 13) ------------------------------------------------------

# NON-SECRET, OPTIONAL (api). Defaults are the code defaults (ADR-0024).
# RATE_LIMIT_READ_MAX=600
# RATE_LIMIT_WRITE_MAX=120
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_WEBHOOK_REPLAY_MAX=20
# RATE_LIMIT_WEBHOOK_REPLAY_WINDOW_SECONDS=300
# RATE_LIMIT_WEBHOOK_ENDPOINT_CREATE_MAX=10
# RATE_LIMIT_WEBHOOK_ENDPOINT_CREATE_WINDOW_SECONDS=3600
# RATE_LIMIT_FAIL_MODE=open

# NON-SECRET, OPTIONAL (api). Proxy trust (ADR-0025/Phase 18 §5): 0/empty is
# only correct when the process faces clients directly. ANY environment behind
# a proxy/load balancer MUST set the real hop count and the proxy CIDR
# allowlist — boot refuses hops without CIDRs, and values must never be
# guessed (the real values belong to Phases 22/24).
# TRUST_PROXY_HOPS=0
# TRUST_PROXY_CIDRS=

# --- Observability (Phase 20) ------------------------------------------------------

# NON-SECRET, OPTIONAL (api + worker). Production default: false — exposing
# the metrics surface is a deliberate act (F9/ADR-0040), paired with the
# Phase 21/24 firewall obligation (internal network only). When enabled,
# set METRICS_SCRAPE_TOKEN and/or keep the port unpublished.
# METRICS_ENABLED=false
# METRICS_PATH=/metrics

# OPTIONAL, SECRET. Bearer token a scraper must present; at least 32
# characters when set (boot refuses a weak token without echoing it).
METRICS_SCRAPE_TOKEN=

# NON-SECRET, OPTIONAL (worker). The worker's metrics/liveness listener port
# (default 9464). Not published to the host network; /health/live answers
# here regardless of METRICS_ENABLED (D7(a)).
# WORKER_METRICS_PORT=9464
