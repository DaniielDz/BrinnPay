# Local development secrets for docker/compose.yml.
# Copy to `.env` and fill in real values: `cp .env.example .env`
# This file is gitignored (.env/.env.* are never committed).

# REQUIRED (boot-time validation): JWT access-token signing secret.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# REQUIRED (boot-time validation): base64 AES-256-GCM key that protects the
# webhook endpoint signing secrets at rest. The worker must use the SAME value
# as the API, otherwise every delivery fails its signature check.
# Generate with: openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=

# --- Optional overrides (defaults are documented in compose.yml) -----------
# PORTS: API_PORT, WEB_PORT, POSTGRES_PORT, REDIS_PORT
# MONITORING: PROMETHEUS_PORT, ALERTMANAGER_PORT, GRAFANA_PORT
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin        # development-only default
# METRICS_SCRAPE_TOKEN=               # >= 32 chars; see monitoring/README.md
