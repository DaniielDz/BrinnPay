# BrinnPay API — production image (Phase 21, D1(a), ADR-0043).
#
# Multi-stage build producing a hardened runtime image that serves the API
# (`node dist/src/main.js`, the default command) and runs the webhook worker
# (`node dist/src/worker.js`, a different command — same image, ADR-0018).
#
# What the runtime layer contains (§6 M1): compiled `dist/` (entrypoints,
# module graph, and the Prisma client compiled into `dist/generated/prisma`),
# production-only `node_modules`, and `docs/openapi.yaml` (F4: the boot path
# throws without it). What it does not contain: TypeScript sources/compiler,
# the Nest CLI, test suites, ESLint, coverage output, `.env*` files, dev
# dependencies, or any secret (§8 rule 1 — secrets arrive only at start time).
#
# The dev Dockerfile (`docker/api/Dockerfile`) and `docker/compose.yml` are
# untouched (D1(a)/§4 rule 7); this file is additive.
#
# Note on entrypoint paths: `nest build` compiles from `apps/api/` because the
# generated Prisma client (`apps/api/generated/prisma`, ADR-0011) is imported
# by relative path, so the compiled entrypoints land at `dist/src/main.js` and
# `dist/src/worker.js` (not `dist/main.js`). The image and the package.json
# `start`/`worker` scripts use the real paths (ADR-0043 §"Runtime payload").

# Pinned base: same Node major and Debian-slim family as dev/CI (Node 22,
# glibc) so argon2's native binding builds against the libc it runs on (F13).
# No `:latest`; digest-level pinning belongs with the registry work of
# Phases 23/24 (D6 boundary).
FROM node:22-bookworm-slim AS builder

ENV PNPM_HOME=/pnpm \
  PATH=/pnpm:$PATH

RUN corepack enable \
  && corepack prepare pnpm@12.4.1 --activate

WORKDIR /app

# Layer order for cache-friendliness (§16): manifests + lockfile first, so a
# source edit never reinstalls dependencies. The lockfile is the single source
# of truth; pnpm's build-script allowlist (`pnpm-workspace.yaml` `allowBuilds`)
# approves the native builds this stage needs (argon2, Prisma).
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json

RUN pnpm install --frozen-lockfile

# Prisma (ADR-0011): schema + CLI config, then the generated client at
# `apps/api/generated/prisma`. The CLI lives in the builder only — migrations
# are executed by the separate pre-start step (D3(a), ADR-0045), never by the
# runtime image.
COPY apps/api/prisma apps/api/prisma
COPY apps/api/prisma.config.ts apps/api/prisma.config.ts
RUN pnpm --filter @brinnpay/api prisma:generate

# Compile. `nest build` emits `dist/src/*.js` plus the generated client
# compiled into `dist/generated/prisma/*.js`, so the runtime import of
# `../../generated/prisma/client` resolves entirely inside `dist/`.
COPY apps/api/nest-cli.json apps/api/nest-cli.json
COPY apps/api/tsconfig.json apps/api/tsconfig.json
COPY apps/api/tsconfig.build.json apps/api/tsconfig.build.json
COPY apps/api/src apps/api/src
RUN pnpm --filter @brinnpay/api build

# Canonical OpenAPI contract (F4/ADR-0012), carried into the runtime stage.
COPY docs/openapi.yaml docs/openapi.yaml

# ---------------------------------------------------------------------------
# Production dependencies only (a separate stage so the runtime layer never
# carries the dev toolchain: tsc, nest, jest, eslint, playwright — §8 rule 3).
# argon2's approved build runs here, on the same platform as the runtime.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS prod-deps

ENV PNPM_HOME=/pnpm \
  PATH=/pnpm:$PATH

RUN corepack enable \
  && corepack prepare pnpm@12.4.1 --activate

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/package.json
RUN pnpm install --frozen-lockfile --prod

# ---------------------------------------------------------------------------
# Runtime: compiled output + production dependencies + the canonical contract.
# Configuration-free by rule (§4 rule 2): NODE_ENV/PORT defaults only; every
# environment-specific value is supplied at start by whatever runs the
# container (D4(a), ADR-0044). Non-root; no pnpm/corepack.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime

# Readable image metadata (§6 M1). VERSION is a non-secret build argument
# defaulted by the caller (local tags only in this phase — D6(a)).
ARG VERSION=0.1.0
LABEL org.opencontainers.image.title="BrinnPay API" \
  org.opencontainers.image.description="BrinnPay payment-sandbox API and webhook worker (production runtime)" \
  org.opencontainers.image.version="${VERSION}" \
  org.opencontainers.image.source="https://github.com/DaniielDz/BrinnPay" \
  org.opencontainers.image.licenses="MIT"

ENV NODE_ENV=production \
  PORT=3000 \
  SERVICE_NAME=brinnpay-api

WORKDIR /app/apps/api

# pnpm's node_modules layout: the package-local tree is relative symlinks into
# the root `.pnpm` store, so both trees are copied with their structure intact.
COPY --from=prod-deps /app/node_modules /app/node_modules
COPY --from=prod-deps /app/apps/api/node_modules /app/apps/api/node_modules
COPY --from=prod-deps /app/apps/api/package.json /app/apps/api/package.json

# Compiled output: entrypoints, module graph, and the generated Prisma client
# (compiled into dist/generated/prisma — no separate copy needed at runtime).
COPY --from=builder /app/apps/api/dist /app/apps/api/dist

# Canonical OpenAPI contract (F4/ADR-0012): resolved at boot relative to the
# working directory (`OPENAPI_PATH` default `../../docs/openapi.yaml` → this
# file). Missing ⇒ bootstrap throws; that refusal is kept, not bypassed.
COPY --from=builder /app/docs/openapi.yaml /app/docs/openapi.yaml

# Non-root runtime user (provided by the base image).
USER node

EXPOSE 3000

# Informational only: probe ownership stays with the deployment/validation
# definition, which uses the exact same semantics — `/health/ready` for the
# API, `/health/live` on WORKER_METRICS_PORT for the worker (Phase 20 §17,
# Phase 2 D9: reachability only, never schema — F16).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch(`http://127.0.0.1:${process.env.PORT || 3000}/health/ready`).then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

# Default: the API. The worker is the same image, different command:
#   docker run … <image> node dist/src/worker.js
# No entrypoint script: migrations are a pre-start step (D3(a)), and nothing
# supervises processes inside the container.
CMD ["node", "dist/src/main.js"]
