{
  "name": "@brinnpay/loadtest",
  "version": "0.1.0",
  "private": true,
  "description": "BrinnPay k6 load-testing harness (phase 19) — scenarios, seeding, receiver, runner. Local-only by design.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint \"scenarios/**/*.ts\" \"lib/**/*.ts\" \"scripts/**/*.mjs\" \"test/**/*.mjs\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test \"test/**/*.test.mjs\"",
    "run": "node scripts/run.mjs",
    "inspect": "node scripts/inspect.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/k6": "2.3.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
