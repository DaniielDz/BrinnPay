# Phase 19 load-test harness — non-secret configuration.
# Copy to `.env` only if you need to deviate from the defaults; the runner
# (`pnpm loadtest`) works with none of these set. NEVER put credentials here.

# API base used by scripts/seed.mjs (host port of the load stack; the runner
# sets API_PORT=3100 for the dedicated compose project).
API_BASE_URL=http://localhost:3100/api/v1

# k6 target. The runner passes the in-network service DNS instead
# (http://api:3000/api/v1); this default is for host-side k6 runs only.
# Load tests run against the local stack only (phase 19 §4 rule 6).
K6_BASE_URL=http://host.docker.internal:3000/api/v1

# Dedicated compose project + ports for load runs, so a dev stack can keep
# running alongside and `down -v` resets only load-run data.
LOADTEST_COMPOSE_PROJECT=brinnpay-loadtest
# API_PORT=3100, POSTGRES_PORT=5543, REDIS_PORT=6380, WEB_PORT=3201
# (the runner exports these itself; listed for documentation).

# Bulk seed sizes (D9: bounded, contract-valid corpus — customers/payments).
SEED_PRIMARY_CUSTOMERS=3000
SEED_PRIMARY_PAYMENTS=5000
SEED_SECONDARY_CUSTOMERS=100
SEED_SECONDARY_PAYMENTS=200
SEED_SCAFFOLD_CUSTOMERS=5
SEED_SCAFFOLD_PAYMENTS=5

# Webhook receiver (scripts/receiver.mjs inside the load stack).
RECEIVER_PORT=4090
LOADTEST_RECEIVER_HOST=brinnpay-loadtest-receiver

# Per-scenario pacing override (seconds between iterations). The committed
# profiles already embed their pacing; set this only when re-baselining.
# K6_SLEEP=0.25
