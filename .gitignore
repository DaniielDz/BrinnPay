```gitignore
# Dependencies
node_modules/
.pnpm-store/

# Environment files
.env
.env.*
!.env.example

# Build output
dist/
build/
.next/
out/
coverage/

# Runtime / cache
.cache/
.tmp/
temp/
*.log

# Testing
.nyc_output/
playwright-report/
test-results/

# TypeScript
*.tsbuildinfo

# Next.js / Vercel
.vercel/

# Prisma local databases
*.db
*.db-journal

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Debug logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
```
